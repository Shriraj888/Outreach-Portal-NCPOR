# ==============================================================================
# NCPOR POLAR SCIENCE OUTREACH PORTAL - ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your confidential API keys:
#   cp .env.example .env

# --- Application Metadata ---
VITE_APP_TITLE="NCPOR • National Polar Science Outreach Portal"
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0

# --- AI & Generative Services ---
# Google Gemini API Key (for real-time polar AI report summarization & outreach generation)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (alternative LLM fallback provider)
VITE_OPENAI_API_KEY=your_openai_api_key_here

# --- Geospatial & 3D Mapping Services ---
# Mapbox public/secret access token (for customized high-latitude polar projections)
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# Cesium Ion Access Token (for 3D photorealistic polar elevation / glacier terrain)
VITE_CESIUM_ION_TOKEN=your_cesium_ion_token_here

# --- Live Telemetry & Real-Time Polar Feeds ---
# Open-Meteo Weather API Base URL (Station AWS coordinates: Bharati, Maitri, Himadri, Himansh)
VITE_OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# NOAA Space Weather Prediction Center (Geomagnetic Kp Aurora index feed)
VITE_NOAA_KP_API_URL=https://services.swpc.noaa.gov/products/noaa-planetary-k-index.json

# CORS Proxy for external feeds (e.g. RSS news from ncpor.res.in)
VITE_CORS_PROXY_URL=https://corsproxy.io/?url=

# NCPOR Official Portal URL
VITE_NCPOR_BASE_URL=https://ncpor.res.in

# --- Backend API & Database ---
# Backend REST API endpoint
VITE_API_BASE_URL=http://localhost:5000/api

# --- Firebase / Authentication & Storage (Optional) ---
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
